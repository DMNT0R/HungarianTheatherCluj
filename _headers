# HTTP-Header für Cloudflare (Workers Static Assets / Pages). nginx nutzt
# deploy/security-headers.conf mit denselben Werten.

/*
  X-Content-Type-Options: nosniff
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: blob: https://*.tile.openstreetmap.org https://www.huntheater.ro; media-src 'self' blob:; connect-src 'self' https://*.tile.openstreetmap.org https://www.huntheater.ro; font-src 'self'; manifest-src 'self'; worker-src 'self'; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'
  Permissions-Policy: geolocation=(self), camera=(self), microphone=(), payment=(), usb=(), bluetooth=(), serial=(), hid=(), midi=(), interest-cohort=()
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Cross-Origin-Opener-Policy: same-origin
  Strict-Transport-Security: max-age=31536000

# App-Code immer frisch prüfen lassen, damit Updates sofort ankommen
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/sw.js
  Cache-Control: no-cache
/js/*
  Cache-Control: no-cache
/css/*
  Cache-Control: no-cache
/manifest.webmanifest
  Cache-Control: no-cache
